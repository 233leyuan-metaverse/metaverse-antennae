{
  "mcpServers": {
    "antennae_sideapi": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CURSOR_PLUGIN_ROOT}/scripts/start-mcp.ps1"
      ],
      "cwd": "${CURSOR_PLUGIN_ROOT}",
      "env": {
        "PYTHONUTF8": "1",
        "SIDEAPI_CLIENT_URL": "ws://127.0.0.1:19931",
        "ANTENNAE_ASSET_SEARCH_BASE_URL": "https://pre-api.meta-verse.co",
        "ANTENNAE_MEMORY_HUB_URL": "http://10.159.3.85:8420",
        "ANTENNAE_MEMORY_HUB_TIMEOUT_SECONDS": "10"
      }
    }
  }
}
